  "formulas": {
    "effective_resistance": "party.resistance_factor * difficulty.resistance_multiplier",
    "active_resistance_force_cap_n": "npc.base_active_resistance_force_cap_n * effective_resistance",
    "max_resistance_budget": "npc.base_resistance_budget * effective_resistance",
    "attack_budget_cost": "attack.budget_cost_base * effective_resistance",
    "anchor_budget_cost_per_s": "npc.anchor_budget_per_s_base * effective_resistance",
    "attack_interval_s": "party.attack_interval_s * difficulty.attack_interval_multiplier; also require finished recovery",
    "attack_composure_loss": "attack.composure_loss * difficulty.attack_impact_multiplier",
    "attack_delta_v_mps": "attack.delta_v_mps * difficulty.attack_impact_multiplier",
    "windup_s": "max(attack_rules.minimum_telegraph_s, attack.windup_s * difficulty.telegraph_multiplier)",
    "round_time_s": "null if not timer_enabled else base_round_time_s + party.time_assist_s"
  },
  "notes": [
    "Initial design values only; no gameplay validation has been performed.",
    "R never scales mass, attack impact, or attack frequency a second time.",
    "Bandwidth value is a planning alarm, not a measured requirement.",
    "On disconnect, grant only any additional unused party time assistance; never reduce remaining time."
  ]
