# Conservar bytes originales de los paquetes de preproducción.
# Los archivos originales incluyen manifiestos y hashes propios.
preproduction/** -text

# Documentación nueva: líneas LF reproducibles.
/*.md text eol=lf
/docs/*.md text eol=lf
/.gitignore text eol=lf
/.gitattributes text eol=lf

# Recursos binarios; sin requerir Git LFS para esta primera entrega.
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.fbx binary
*.glb binary
*.blend binary
*.ttf binary
*.zip binary

# Archivos futuros del proyecto Unity.
*.cs text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.inputactions text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Proyecto Unity: texto LF reproducible (añadido 2026-11-15, M0).
UnityProject/**/*.json text eol=lf
UnityProject/**/*.asmdef text eol=lf
UnityProject/**/*.physicMaterial text eol=lf
UnityProject/ProjectSettings/*.txt text eol=lf
